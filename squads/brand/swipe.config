# ============================================================
# BRAND SQUAD — swipe.config
# Configuracao do sistema de swipe files
# ============================================================

swipe:
  version: "1.0.0"
  description: "Configuracao de curadoria e organizacao de swipe files do Brand Squad"

  # Diretorios de swipe
  directories:
    primary: "swipe/"
    sources: "swipe-sources/"

  # Categorias de swipe
  categories:
    brand-books:
      path: "swipe/brand-books/"
      description: "Brand books e guidelines exemplares"
      tags: ["guidelines", "brand-book", "visual-identity"]

    taglines:
      path: "swipe/taglines/"
      description: "Taglines por arquetipo e categoria"
      tags: ["tagline", "slogan", "verbal"]

    naming:
      path: "swipe/naming/"
      description: "Nomes de marca memoraveis e anti-exemplos"
      tags: ["naming", "brand-name", "verbal"]

    manifestos:
      path: "swipe/manifestos/"
      description: "Manifestos e purpose statements"
      tags: ["manifesto", "purpose", "narrative"]

    identity-systems:
      path: "swipe/identity-systems/"
      description: "Sistemas de identidade visual"
      tags: ["visual", "identity", "design-system"]

    positioning:
      path: "swipe/positioning/"
      description: "Posicionamentos e category creation"
      tags: ["positioning", "category", "strategy"]

    campaigns:
      path: "swipe/campaigns/"
      description: "Lancamentos, rebrands e campanhas de awareness"
      tags: ["campaign", "launch", "rebrand"]

    brand-experience:
      path: "swipe/brand-experience/"
      description: "Touchpoints e experiencias excepcionais"
      tags: ["experience", "touchpoint", "ritual"]

  # Fontes de curadoria
  sources:
    - name: "Brand New (UnderConsideration)"
      type: "blog"
      focus: "rebrands and new identities"
    - name: "Branding Style Guides Archive"
      type: "gallery"
      focus: "brand guidelines collections"
    - name: "Behance / Dribbble"
      type: "portfolio"
      focus: "identity design"
    - name: "SwipeFile.com"
      type: "curated"
      focus: "marketing and brand swipe"

  # Regras de curadoria
  curation_rules:
    min_quality: "notable brand or award-winning work"
    include_analysis: true
    include_anti_examples: true
    format: "markdown with screenshots/descriptions"
    update_cadence: "quarterly"
